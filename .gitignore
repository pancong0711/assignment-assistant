# ===== 数据与敏感信息红线（绝不允许进入仓库）=====
# 行内注释在 gitignore 中无效，只允许整行注释
_legacy/
kb/*
!kb/examples/
roster/
grading/
# 引擎源码例外（代码非数据；产物 classes/*//grading 数据仍被上面拦住）
!engine/src/assist/grading/
test/
test_*
!engine/tests/
!engine/tests/test_*.py
tests/data/
exports/
damage/
handwriting/
submissions/
.env
.env.*
!.env.example
config.json
config.local.json
state.json
*xuexitong*ids*.json
*.token
*apikey*
*.key

# 学生/真实内容类数据（保守双保险）
**/作业/

# 中文字体（版权限制，教师自备）
*.ttc
*.ttf
*.otf
# 开源字体如需入库在此追加白名单例外

# ===== 常规 =====
__pycache__/
*.pyc
.venv/
node_modules/
dist/
.pytest_cache/
.ruff_cache/
.DS_Store

# AI 辅助工具目录不入库
.opencode/
.pi/
.agents/

# 开发/验证 scratch（本机沙箱演示用）
.scratch/
# 真实水印/logo 资产不入库（占位图除外，教师自行替换）
engine/assets/watermark/
!engine/assets/watermark/.gitkeep
